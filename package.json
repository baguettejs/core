{
  "name": "@baguettejs/core",
  "version": "1.0.0",
  "type": "module",
  "description": "🥖 Core framework for BaguetteJS — minimalist TypeScript backend",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "scripts": {
    "build": "bun x tsc -b tsconfig.json",
    "clean": "bun x tsc -b tsconfig.json --clean"
  },
  "dependencies": {
    "@baguettejs/utils": "^1.0.0",
    "reflect-metadata": "^0.2.2"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "keywords": [
    "typescript",
    "framework",
    "backend",
    "decorators",
    "baguettejs"
  ],
  "author": "Cyprien Tertrais",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^5.9.2"
  }
}
